{
  "name": "feature-tree",
  "displayName": "Feature Tree",
  "description": "Visual, color-coded viewer for features/ markdown trees",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:features/SCHEMA.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "featureTree.openGraph",
        "title": "Feature Tree: Open Graph"
      }
    ],
    "customEditors": [
      {
        "viewType": "featureTree.node",
        "displayName": "Feature Node",
        "selector": [{ "filenamePattern": "**/features/**/*.md" }],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "featureTree",
          "title": "Feature Tree",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "featureTree": [
        {
          "id": "featureTree.sidebar",
          "name": "Feature Tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "featureTree.sidebar",
        "contents": "View the feature tree as a graph.\n[Open Graph](command:featureTree.openGraph)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "tsc -p . && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.0"
  }
}
